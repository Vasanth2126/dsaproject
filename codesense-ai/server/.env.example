# ==========================================
# CodeSense AI — Environment Variables
# ==========================================

# 1. JWT Secret key for authentication signing
JWT_SECRET=generate_a_long_secure_random_string_here

# 2. Server Port (Render sets PORT automatically)
PORT=5000

# 3. Optional: Groq API Key (Free High-Speed LLM Inference)
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# 4. Optional: Anthropic / Voyage Keys (if using direct Claude/Voyage)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# 5. Optional: GitHub Personal Access Token (for higher repo fetch limits)
GITHUB_TOKEN=ghp_your_github_token_here

# 6. Production Frontend Domain URL for CORS
CLIENT_ORIGIN=https://your-app-name.onrender.com
